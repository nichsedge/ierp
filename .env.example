# ierp media sync profile overrides (copy to .env or add to ~/.secrets).
# All values are OPTIONAL — hardcoded defaults exist in ierp/core/config.py.
# Env var format: IERP_<SOURCE>__<FIELD> (source names uppercased).

# Tracker usernames / IDs
#IERP_HARDCOVER__USERNAME=your_hardcover_username
#IERP_GOODREADS__USER_ID=your_goodreads_user_id
#IERP_LETTERBOXD__USERNAME=your_letterboxd_username
#IERP_ANILIST_ANIME__USERNAME=your_anilist_username
#IERP_ANILIST_MANGA__USERNAME=your_anilist_username
#IERP_MYDRAMALIST__USERNAME=your_mdl_username

# API tokens (required for hardcover; get one free at https://hardcover.app/account/api)
# May include the "Bearer " prefix — both forms work.
#HARDCOVER_API_KEY=your_hardcover_token
